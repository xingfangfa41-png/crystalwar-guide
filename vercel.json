{
  "rewrites": [
    {
      "source": "/api/group/:groupId",
      "destination": "https://uapis.cn/api/v1/social/qq/groupinfo?group_id=:groupId"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-sample",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
