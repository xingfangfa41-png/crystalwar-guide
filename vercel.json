{
  "rewrites": [
    {
      "source": "/api/group/:groupId",
      "destination": "https://uapis.cn/api/v1/social/qq/groupinfo?group_id=:groupId"
    },
    {
      "source": "/EC社群自治.html",
      "destination": "/"
    },
    {
      "source": "/EC%E7%A4%BE%E7%BE%A4%E8%87%AA%E6%B2%BB.html",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://market.ec-crystal-war.com"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}